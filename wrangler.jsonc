{
  "name": "x-push-probe",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": { "MODE": "record" },
  "durable_objects": {
    "bindings": [{ "name": "INBOX", "class_name": "Inbox" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Inbox"] }]
}
