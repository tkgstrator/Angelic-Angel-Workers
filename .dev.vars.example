# Copy to .dev.vars for local development. Do not commit real credentials.
ADMIN_TOKEN="replace-with-a-long-random-secret"
X_AUTH_TOKEN="replace-with-the-x-auth_token-cookie"
X_CT0="replace-with-the-x-ct0-cookie"
WEBHOOK_ENDPOINT="https://example.invalid/webhook"

# Optional: enables the original push probe routes.
# PROBE_TOKEN="replace-with-a-separate-probe-token"
