{
  "name": "angelic-angel-workers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env=",
    "deploy": "wrangler deploy --env= --minify",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "lint": "bunx --bun biome check",
    "format": "bunx --bun biome check --write",
    "test": "bun test && node --test __tests__/worker/*.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test:unit": "bun test",
    "test:workers": "node --test __tests__/worker/*.mjs",
    "deploy:staging": "wrangler deploy --env staging --minify"
  },
  "dependencies": {
    "@commitlint/config-conventional": "^21.2.0",
    "commitlint": "^21.2.1",
    "conventional-changelog-conventionalcommits": "^10.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@cloudflare/workers-types": "^4",
    "@types/bun": "^1",
    "typescript": "^7",
    "wrangler": "^4",
    "miniflare": "5.20261006.0-alpha"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.2"
  }
}
